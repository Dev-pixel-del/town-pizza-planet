# Town Pizza Planet — Production Environment

STORE_NAME=Town Pizza Planet
STORE_PHONE=YOUR_RESTAURANT_PHONE
OWNER_PHONE=91XXXXXXXXXX

# Render automatically provides PORT. Leave this as-is locally unless needed.
PORT=3000

# Restaurant admin
ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
NODE_ENV=production

# Operating hours (set RESTRICT_HOURS=false for 24/7 acceptance)
RESTRICT_HOURS=false
OPEN_HOUR=10
CLOSE_HOUR=23

# FREE delivery threshold
FREE_DELIVERY_THRESHOLD=150
MINIMUM_DELIVERY_ORDER=150

# Delivery service radius — set your real service area
DELIVERY_RADIUS_KM=5

# Restaurant coordinates — required for location validation
RESTAURANT_LATITUDE=YOUR_LATITUDE
RESTAURANT_LONGITUDE=YOUR_LONGITUDE

# REQUIRED on Render for durable orders/sessions and persistent WhatsApp session.
# Create a free MongoDB Atlas cluster and paste its connection string here.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/town_pizza_planet?retryWrites=true&w=majority
REQUIRE_MONGODB=true

# Optional: local Chrome/Chromium executable path. Leave empty on Render unless required.
PUPPETEER_EXECUTABLE_PATH=

PUBLIC_ORDER_URL=https://town-pizza-planet.onrender.com
